#!/usr/bin/env ysh
# SPDX-License-Identifier: GPL-3.0-or-later
# Grease's pinned Oils/YSH implementation; no Bash implementation or downloads.
if (len(ARGV) !== 6) {
  echo 'usage: ysh build.grease REPO NDK BUILD_TOOLS ANDROID_JAR OUTPUT HOST_CC'
  exit 2
}
var repository = $[ARGV[0]]
var ndk = $[ARGV[1]]
var tools = $[ARGV[2]]
var android_jar = $[ARGV[3]]
var output = $[ARGV[4]]
var host_cc = $[ARGV[5]]
for location in ([repository, ndk, tools, android_jar, output, host_cc]) {
  if (not location.startsWith('/')) { echo "FAIL absolute input required: $location"; exit 2 }
}
var dirty = $(git -C "$repository" status --porcelain --untracked-files=normal)
if (dirty !== '') { echo 'FAIL commit source before producing an acceptance artifact'; exit 2 }
var compiler = "$ndk/toolchains/llvm/prebuilt/linux-x86_64/bin/armv7a-linux-androideabi21-clang"
var llvm = "$ndk/toolchains/llvm/prebuilt/linux-x86_64/bin"
var key = "$repository/android/signing/development.p12"
for required in ([compiler, "$llvm/llvm-strip", "$llvm/llvm-readelf", "$tools/aapt2", "$tools/aapt", "$tools/zipalign", "$tools/apksigner", android_jar, key, host_cc]) {
  if ! test -f "$required" { echo "FAIL missing input: $required"; exit 2 }
}
rg -q '^Pkg.Revision = 29.0.14206865$' "$ndk/source.properties"
rg -q '^Pkg.Revision=36.0.0$' "$tools/source.properties"
var platform = $(dirname "$android_jar")
rg -q '^AndroidVersion.ApiLevel=34$' "$platform/source.properties"
rg -q '^AndroidVersion.ExtensionLevel=12$' "$platform/source.properties"
rg -q '^Pkg.Revision=1$' "$platform/source.properties"
var key_digest = $(sha256sum "$key" | cut -d ' ' -f 1)
if (key_digest !== 'd83f7a36a205e49b4c755f37d27a0ded02779acc0da82a22e19d458dc6e5a89a') {
  echo 'FAIL stable public development key digest'; exit 2
}
# Existing public organization test key. No key generation, secrets or fallback.
mkdir -p "$output"
var work = $(mktemp -d "$output/work.XXXXXX")
keytool -exportcert -keystore "$key" -storetype PKCS12 -storepass wegert-debug -alias wegert-debug -file "$work/certificate.der"
var certificate_digest = $(sha256sum "$work/certificate.der" | cut -d ' ' -f 1)
if (certificate_digest !== 'de9b1d47c5a65e6d46a204b79dd9ee566b9d3c9832ba81ebc4213d3392e92ff9') {
  echo 'FAIL stable development certificate'; exit 2
}
printf '\033[36mBUILD Byrne III.1 / armeabi-v7a\033[0m\n'
"$host_cc" -std=c11 -O2 -Wall -Wextra -Werror -pedantic -I "$repository/code" \
  "$repository/code/geometry.c" "$repository/code/proposition1.c" "$repository/code/applet.c" \
  "$repository/tests/geometry_test.c" -lm -o "$work/geometry-test"
"$work/geometry-test" > "$output/geometry-tests.txt"
cat "$output/geometry-tests.txt"
"$host_cc" -std=c11 -O2 -Wall -Wextra -Werror -pedantic -I "$repository/code" \
  "$repository/code/geometry.c" "$repository/code/proposition1.c" "$repository/code/applet.c" \
  "$repository/code/render.c" "$repository/tests/render_preview.c" -lm -o "$work/render-preview"
"$work/render-preview" "$output/preview.ppm"
mkdir -p "$work/payload/lib/armeabi-v7a"
"$compiler" -std=c11 -O2 -fPIC -marm -Wall -Wextra -Werror -Wno-unused-parameter \
  -I "$ndk/sources/android/native_app_glue" \
  -c "$ndk/sources/android/native_app_glue/android_native_app_glue.c" -o "$work/native_app_glue.o"
"$compiler" -std=c11 -O2 -fPIC -shared -marm -Wall -Wextra -Werror \
  -I "$repository/code" -I "$ndk/sources/android/native_app_glue" \
  "$repository/code/geometry.c" "$repository/code/proposition1.c" "$repository/code/applet.c" \
  "$repository/code/render.c" "$repository/android/native_main.c" \
  "$work/native_app_glue.o" \
  -Wl,-u,ANativeActivity_onCreate -Wl,--no-undefined -Wl,-z,max-page-size=16384 \
  -Wl,--build-id=sha1 -Wl,-soname,libbyrne.so -landroid -llog -lm \
  -o "$work/payload/lib/armeabi-v7a/libbyrne.so"
"$llvm/llvm-strip" --strip-unneeded "$work/payload/lib/armeabi-v7a/libbyrne.so"
"$llvm/llvm-readelf" -h -d "$work/payload/lib/armeabi-v7a/libbyrne.so" > "$output/native-library.txt"
rg -q 'Class:.*ELF32' "$output/native-library.txt"
rg -q 'Machine:.*ARM' "$output/native-library.txt"
if rg -q 'libc\+\+|libstdc\+\+' "$output/native-library.txt" { echo 'FAIL C++ runtime dependency'; exit 2 }
"$tools/aapt2" link -I "$android_jar" --manifest "$repository/android/AndroidManifest.xml" \
  --min-sdk-version 21 --target-sdk-version 34 -o "$work/unsigned.apk"
touch -t 198001010000 "$work/payload/lib/armeabi-v7a/libbyrne.so"
cd "$work/payload"
zip -X -0 "$work/unsigned.apk" lib/armeabi-v7a/libbyrne.so
"$tools/zipalign" -f -P 16 4 "$work/unsigned.apk" "$work/aligned.apk"
var apk = "$output/byrne-euclid-iii1-miro-a1.apk"
"$tools/apksigner" sign --ks "$key" --ks-key-alias wegert-debug --ks-pass pass:wegert-debug \
  --key-pass pass:wegert-debug --v1-signing-enabled true --v2-signing-enabled true \
  --v3-signing-enabled false --v4-signing-enabled false --out "$apk" "$work/aligned.apk"
"$tools/apksigner" verify --verbose --print-certs "$apk" > "$output/signer.txt"
rg -q "Signer #1 certificate SHA-256 digest: $certificate_digest" "$output/signer.txt"
"$tools/zipalign" -c -P 16 4 "$apk"
unzip -Z1 "$apk" > "$output/package-files.txt"
rg -q '^lib/armeabi-v7a/libbyrne.so$' "$output/package-files.txt"
if rg -q '\.dex$|lib/arm64|lib/x86|\.java$|\.kt$' "$output/package-files.txt" { echo 'FAIL unexpected application layer or ABI'; exit 2 }
"$tools/aapt" dump badging "$apk" > "$output/package-badging.txt"
rg -q "package: name='org.isomorphismes.byrne.euclid.iii1'" "$output/package-badging.txt"
rg -q "launchable-activity: name='android.app.NativeActivity'" "$output/package-badging.txt"
"$tools/aapt" dump xmltree "$apk" AndroidManifest.xml > "$output/package-manifest.txt"
rg -q 'hasCode.*0x0' "$output/package-manifest.txt"
var source = $(git -C "$repository" rev-parse HEAD)
var apk_digest = $(sha256sum "$apk" | cut -d ' ' -f 1)
var source_tree = $(git -C "$repository" rev-parse 'HEAD^{tree}')
var compiler_digest = $(sha256sum "$llvm/clang" | cut -d ' ' -f 1)
var jar_digest = $(sha256sum "$android_jar" | cut -d ' ' -f 1)
var host_identity = $(uname -sm)
{
  echo "source_commit=$source"
  echo "source_tree=$source_tree"
  echo 'source_dirty=false'
  echo "host=$host_identity"
  echo "ndk_compiler_sha256=$compiler_digest"
  echo "android_jar_sha256=$jar_digest"
  echo 'ndk=29.0.14206865'
  echo 'build_tools=36.0.0'
  echo 'sdk_platform=34 extension 12 revision 1'
  echo 'abi=armeabi-v7a'
  echo 'min_sdk=21'
  echo 'target_sdk=34'
  echo "signer_certificate_sha256=$certificate_digest"
  echo "apk_sha256=$apk_digest"
  echo 'lua_compiled=false'
  echo 'lua_gitlink=6e22fedb74cf0c9b6656e9fce8b7331db847c605'
  echo 'android_ndk_reference=d4a4719fb97e8031476bf822697dce8423bc9030'
  echo 'grease_source=6d29702a10ea9eb72a43950554dbcd4174d07a89'
  echo 'source_build=PASS'
  echo 'geometry=PASS'
  echo 'package_structure=PASS'
  echo 'alignment=PASS'
  echo 'signer=PASS'
  echo 'android_launch=NOT_RUN'
  echo 'physical_miro_a1=NOT_RUN'
} > "$output/build-receipt.txt"
git -C "$repository" diff --binary HEAD > "$output/source-diff.patch"
sha256sum "$apk" > "$output/SHA256SUMS.txt"
printf '\033[32mPASS geometry, native build, package, alignment, stable signer\033[0m\n'
echo "$apk"
